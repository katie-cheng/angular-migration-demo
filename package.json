{
  "name": "retail-bank-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve retail-banking",
    "build": "ng build retail-banking",
    "watch": "ng build --watch --configuration development",
    "test": "ng test retail-banking --watch=false --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint",
    "mock-backend": "node tools/mock-backend/server.js",
    "build:libs": "ng build ui-kit && ng build auth && ng build analytics-sdk && ng build data-providers",
    "build:all": "npm run build:libs && ng build retail-banking && ng build small-business-portal && ng build wealth-advisor",
    "test:libs": "ng test ui-kit --watch=false --browsers=ChromeHeadlessNoSandbox && ng test auth --watch=false --browsers=ChromeHeadlessNoSandbox && ng test analytics-sdk --watch=false --browsers=ChromeHeadlessNoSandbox && ng test data-providers --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:coverage": "ng test retail-banking --watch=false --code-coverage --browsers=ChromeHeadlessNoSandbox",
    "e2e:behaviour": "playwright test",
    "generate:ui-kit": "node tools/generate/gen-ui-kit.js",
    "generate:features": "node tools/generate/gen-features.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.2.0",
    "@angular/cdk": "^14.2.7",
    "@angular/common": "^14.2.0",
    "@angular/compiler": "^14.2.0",
    "@angular/core": "^14.2.0",
    "@angular/forms": "^14.2.0",
    "@angular/material": "^14.2.7",
    "@angular/platform-browser": "^14.2.0",
    "@angular/platform-browser-dynamic": "^14.2.0",
    "@angular/router": "^14.2.0",
    "@northwind/legacy-charts": "file:vendor/northwind-legacy-charts-2.3.1.tgz",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.13",
    "@angular-eslint/builder": "14.4.0",
    "@angular-eslint/eslint-plugin": "14.4.0",
    "@angular-eslint/eslint-plugin-template": "14.4.0",
    "@angular-eslint/schematics": "14.4.0",
    "@angular-eslint/template-parser": "14.4.0",
    "@angular/cli": "~14.2.13",
    "@angular/compiler-cli": "^14.2.0",
    "@playwright/test": "^1.32.3",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^16.18.11",
    "@typescript-eslint/eslint-plugin": "5.43.0",
    "@typescript-eslint/parser": "5.43.0",
    "axe-core": "^4.7.2",
    "concurrently": "^7.6.0",
    "cors": "^2.8.5",
    "eslint": "^8.28.0",
    "express": "^4.18.2",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "loader-utils": "^1.4.0",
    "minimist": "^1.2.0",
    "ng-packagr": "^14.2.0",
    "puppeteer": "^13.7.0",
    "sass": "^1.54.9",
    "typescript": "~4.7.2"
  }
}
