    "retail-banking": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/retail-banking",
      "sourceRoot": "projects/retail-banking/src",
      "prefix": "bk",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/retail-banking",
            "index": "projects/retail-banking/src/index.html",
            "main": "projects/retail-banking/src/main.ts",
            "polyfills": "projects/retail-banking/src/polyfills.ts",
            "tsConfig": "projects/retail-banking/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/retail-banking/src/favicon.ico",
              "projects/retail-banking/src/assets"
            ],
            "styles": [
              "projects/retail-banking/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/retail-banking/src/environments/environment.ts",
                  "with": "projects/retail-banking/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "retail-banking:build:production"
            },
            "development": {
              "browserTarget": "retail-banking:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "retail-banking:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/retail-banking/src/test.ts",
            "polyfills": "projects/retail-banking/src/polyfills.ts",
            "tsConfig": "projects/retail-banking/tsconfig.spec.json",
            "karmaConfig": "projects/retail-banking/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/retail-banking/src/favicon.ico",
              "projects/retail-banking/src/assets"
            ],
            "styles": [
              "projects/retail-banking/src/styles.scss"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/retail-banking/**/*.ts",
              "projects/retail-banking/**/*.html"
            ]
          }
        }
      }
    },
